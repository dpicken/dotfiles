#!/bin/bash

set -euo pipefail

if ( [ $# -eq 1 ] && [ "$1" = "--help" ] ) || [ $# -gt 1 ]; then
  echo "Usage: $(basename $0) [branch name]"
  exit
fi

base_branch=${1:-master}
echo $base_branch

trap_cmds=""
trap_add() {
  local cmd="$1"
  trap_cmds="$cmd; $trap_cmds"
  trap "{ $trap_cmds }" EXIT SIGINT SIGTERM
}

topic_branch="$(git rev-parse --abbrev-ref HEAD)"
topic_status="$(git status --porcelain)"

if [ -n "$topic_status" ]; then
  git stash save --include-untracked
  trap_add "git stash pop"
fi

if [ "$topic_branch" != "$base_branch" ]; then
  git checkout "$base_branch"
  trap_add "git checkout $topic_branch"
fi

git pull

if [ "$topic_branch" != "$base_branch" ]; then
  git checkout "$topic_branch"
  git rebase "$base_branch"
fi
